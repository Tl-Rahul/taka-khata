# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: comma-separated emails allowed to sign in. Leave empty to allow anyone
# (use this while the app is personal-only; clear it when you launch publicly).
ALLOWED_EMAILS=
